        "enabled": true,
        "category": "tooling-ai"
      },
      {
        "name": "Visual Studio Code",
        "url": "https://code.visualstudio.com/feed.xml",
        "enabled": true,
        "category": "tooling-ai"
      },
      {
        "name": "GitHub Copilot (Microsoft Dev Blog)",
        "url": "https://developer.microsoft.com/blog/category/github-copilot/feed",
