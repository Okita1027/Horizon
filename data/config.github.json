{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "api_key_env": "DEEPSEEK_API_KEY",
    "languages": ["zh"],
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "xxx@qq.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "dotnet",
        "repo": "runtime",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "dotnet",
        "repo": "aspnetcore",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "dotnet",
        "repo": "maui",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "dotnet",
        "repo": "efcore",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "dotnet",
        "repo": "roslyn",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "AvaloniaUI",
        "repo": "Avalonia",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "grpc",
        "repo": "grpc-dotnet",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "microsoft",
        "repo": "semantic-kernel",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 80
    },
    "rss": [
